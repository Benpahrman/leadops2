# PayPal Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:8765/payment/success
PAYPAL_CANCEL_URL=http://localhost:8765/payment/cancel
PAYPAL_PLAN_ID_WEEKLY=
PAYPAL_PLAN_ID_DAILY=
PAYPAL_PLAN_ID_AI=

# AI / LLM Configuration
GEMINI_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11435/v1
LOCAL_LLM_MODEL=qwen2.5:3b

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=

# LeadOps Internal API
LEADOPS_API_TOKEN=
LEADOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Admin Emails (comma-separated)
LEADOPS_ADMIN_EMAILS=pahrmancb@gmail.com,pharmancb@gmail.com
VITE_ADMIN_EMAILS=pahrmancb@gmail.com,pharmancb@gmail.com

# Frontend Vite Configuration
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000

# Safety & Outreach Controls
LEADOPS_REQUIRE_HUMAN_APPROVAL=true
OUTREACH_DISPATCH_ENABLED=false

# Native Company Gmail Email Module (SMTP / IMAP via Google App Password)
GMAIL_USER=your-company@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=Alex | OmniLeadFeeder
EMAIL_FROM_EMAIL=alex@email.omnileadfeeder.tech
OUTREACH_SENDING_DOMAINS=email.omnileadfeeder.tech,contact.omnileadfeeder.tech
OUTREACH_SENDING_STRATEGY=rotate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=60
INBOUND_WATCHER_ENABLED=true

# -------------------------------------------------------------
# OLFMAILER / AZURE COMMUNICATION SERVICES OUTBOUND SENDING POOL
# Sends via Azure Communication Services REST API (Port 443 HTTPS)
# Inbound prospect replies routed via Cloudflare Email Routing to watched inbox
# -------------------------------------------------------------
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
AZURE_COMMUNICATION_SENDER_DOMAIN=olfmailer.com
AZURE_COMMUNICATION_SENDER_EMAIL=ben@olfmailer.com

# Structured Sending Inboxes JSON (Defaults to ben@olfmailer.com, alex@olfmailer.com, contact@olfmailer.com)
OLFMAILER_INBOXES_JSON=[{"id":"olf_ben","email_address":"ben@olfmailer.com","from_name":"Ben | OmniLeadFeeder"},{"id":"olf_alex","email_address":"alex@olfmailer.com","from_name":"Alex | OmniLeadFeeder"},{"id":"olf_contact","email_address":"contact@olfmailer.com","from_name":"OmniLeadFeeder Operations"}]


# Warmup Schedule (Daily dispatch limits: Week 1=25, Week 2=50, Week 3=75, Week 4=100)
WARMUP_WEEK1_LIMIT=25
WARMUP_WEEK2_LIMIT=50
WARMUP_WEEK3_LIMIT=75
WARMUP_WEEK4_LIMIT=100
WARMUP_START_DATE=

# Cold Email Link Delivery Strategy: 'permission_first' (recommended for warmup) | 'direct_link' | 'plain_domain'
COLD_EMAIL_LINK_MODE=permission_first

# Environment (development, test, production)
ENV=development
ALLOW_DEV_ADMIN=true

# Autonomous Scout & Prospector Pacing
SCOUT_AUTOMATION_ENABLED=true
SCOUT_TARGET_PER_CYCLE=1                        # Discovers 1 high-intent lead per cycle
SCOUT_MIN_REST_SECONDS=3600                     # Minimum rest: 1 hour (3600s)
SCOUT_MAX_REST_SECONDS=7200                     # Maximum rest: 2 hours (7200s)
# SCOUT_INTERVAL_SECONDS=3600                   # Optional fixed interval override

# Real-time Operator Mobile Notifications (Discord Webhook & Telegram Bot)
NOTIFICATIONS_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-channel-id/your-token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=your-telegram-chat-id

# External Prospect Email Discovery APIs (Optional Free-Tier Fallbacks)
# Hunter.io (25 free searches/month): https://hunter.io/
HUNTER_API_KEY=
# Apollo.io (50 free email credits/month): https://apollo.io/
APOLLO_API_KEY=

# Multi-Layer Proxy & Cloud Egress Options (Bypasses Azure Datacenter IP Bans)
# Option 1: Cloudflare Edge Worker (100k free req/day, 0 card needed)
CLOUDFLARE_EDGE_PROXY_URL=https://leadops-edge-proxy.your-account.workers.dev

# Option 2: Webshare.io (10 permanent free proxies at webshare.io, 0 card needed)
SCRAPER_PROXY_URL=http://your_username:your_password@p.webshare.io:80/

# Option 3: Zyte Smart Proxy Manager (SPM) (requires credit card activation)
ZYTE_API_KEY=your_zyte_spm_api_key_here

# Option 4: Autonomous Live Proxy Rotator (Auto-scrapes & live-tests US proxies, 0 setup)
AUTONOMOUS_PROXY_ENABLED=true