# Production Dockerfile for Autonomous Swarm & Playwright Scraper Worker
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Install system dependencies, libpq, and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libpq5 \
    gcc \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright and headless Chromium with requisite system libraries
RUN playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*

# Copy application codebase
COPY agents /app/agents
COPY scripts /app/scripts
COPY run_server.py /app/run_server.py
COPY pytest.ini /app/pytest.ini

RUN mkdir -p /app/build_artifacts /app/backups

# Default entrypoint runs the background queue consumer worker
CMD ["python", "-m", "agents.worker"]
